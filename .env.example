OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_SITE_URL=https://github.com/GoldevLab/jobbot
OPENROUTER_APP_NAME=JobBot
DATABASE_URL=sqlite:data/jobbot.db
JOBBOT_CHROME_CDP=http://127.0.0.1:9222
JOBBOT_CHROME_PROFILE=~/.config/jobbot-chrome
JOBBOT_CV_PATH=/absolute/path/to/your-cv.pdf
JOBBOT_AUTO_APPLY=true
JOBBOT_RATE_LIMIT_SECS=20
JOBBOT_KEYWORDS=backend,nodejs,node.js,typescript,web3,blockchain,rust,engineer,developer
JOBBOT_LOCATIONS=norway,oslo,remote,europe
RUST_LOG=info
